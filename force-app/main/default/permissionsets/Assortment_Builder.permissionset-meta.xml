<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Assortment Builder</label>
    <description>Access required to use the Assortment Builder component: Apex controller + variation attribute field read.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>AssortmentBuilderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <field>ProductAttribute.Clothing_Sizes__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>ProductAttribute.Clothing_Colors__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
